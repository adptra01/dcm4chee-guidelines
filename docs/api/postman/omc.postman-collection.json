{
  "info": {
    "name": "ORP omc",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{base_url}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "health"
          ]
        },
        "header": [],
        "description": ""
      }
    },
    {
      "name": "Import Study",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{base_url}/studies/import",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "studies",
            "import"
          ]
        },
        "header": [],
        "description": "Terima file DICOM, simpan ke incoming/, masukkan antrean."
      }
    },
    {
      "name": "List Studies",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{base_url}/studies",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "studies"
          ]
        },
        "header": [],
        "description": "Isi antrean (persisten)."
      }
    },
    {
      "name": "Study Preview",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{base_url}/studies/:study_id/preview",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "studies",
            ":study_id",
            "preview"
          ]
        },
        "header": [],
        "description": "Preview PNG (window/level dari tag file)."
      }
    },
    {
      "name": "Study Store",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{base_url}/studies/:study_id/store",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "studies",
            ":study_id",
            "store"
          ]
        },
        "header": [],
        "description": "C-STORE ke Orthanc (DICOM 4242, AE ORTHANC)."
      }
    },
    {
      "name": "Settings",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{base_url}/settings",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "{base_url}",
            "settings"
          ]
        },
        "header": [],
        "description": "Konfigurasi target DICOM (dari env) + status koneksi via C-ECHO."
      }
    }
  ]
}